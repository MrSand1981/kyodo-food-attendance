# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
# dist/ is included so cloud hosts and cloned repos have pre-built assets
build/
*.local

# Binary and Executables (Do NOT commit large binaries to git; use GitHub Releases)
bin/*.exe
bin/node.exe
*.exe
cloudflared.exe
installer_output/

# Secrets and credentials
.env
.env.*
.jwt_secret

# Live business data - NEVER commit live customer/employee data to git
data/*
!data/.gitkeep
!data/template_database.json

# Docker
.docker/