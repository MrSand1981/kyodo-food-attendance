# Kyodo Food Attendance - Docker Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=production
PORT=5000

# =============================================================================
# Database (JSON file-based by default, no external DB required)
# Optional: MongoDB Atlas for cloud sync
# =============================================================================
MONGODB_URI=

# =============================================================================
# JWT Configuration (REQUIRED - generate a strong secret!)
# =============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# Admin Configuration
# =============================================================================
DEFAULT_ADMIN_PASSWORD=20162020
DEFAULT_ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@kyodofood.com
ADMIN_PHONE=0905123456

# =============================================================================
# GitHub Auto-Update Configuration
# =============================================================================
GITHUB_REPO=https://github.com/MrSand1981/kyodo-food-attendance
# Generate at: https://github.com/settings/tokens (need repo scope)
GITHUB_TOKEN=

# =============================================================================
# Optional: Email/SMS for notifications (not implemented yet)
# =============================================================================
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=