# Kyodo Food Attendance - Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (JSON file-based, no config needed)
# For MongoDB Atlas (optional):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/kyodo_food

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Admin Default Password (will be hashed on first run)
# DEFAULT_ADMIN_PASSWORD=20162020

# GitHub Repository for Auto-Update
GITHUB_REPO=https://github.com/MrSand1981/kyodo-food-attendance

# GitHub Personal Access Token (for auto-update to work)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Email/SMS for Admin Recovery (optional)
# ADMIN_EMAIL=admin@kyodofood.com
# ADMIN_PHONE=0905123456